exec::pub enum Touched { Nothing, Pins, Review(PrNumber), Dropped(RepoName, PrNumber), LoginStarted(StartedLogin), Keychain, }
failure::pub enum Failure { Session(SessionError), NotChanged { number: PrNumber, file: RelativePath, }, NotInDiff { file: RelativePath, side: Side, line: Line, }, EmptyComment, NoThread(Given), Draft(DraftError), NoSuchFile(RelativePath), NoSuchSymbol(SymbolName), BadPattern(regex::Error), NoToken(ForgeHost), }
failure::pub struct Given(String);
failure::pub fn as_str(&self) -> &str
pub struct Argument(String);
pub fn new(text: &str) -> Self
pub fn as_str(&self) -> &str
pub struct CommandLine(String);
pub fn new(line: &str) -> Self
pub fn as_str(&self) -> &str
pub fn arguments(&self) -> Vec<Argument>
pub enum Channel { Stdout, Stderr, }
pub struct ParseFailure(clap::Error);
pub fn text(&self) -> Output
pub fn channel(&self) -> Channel
pub struct Invocation { request: Result<Request, Failure>, }
pub fn parse(arguments: &[Argument]) -> Result<Self, ParseFailure>
pub struct PastedToken(String);
pub fn new(text: &str) -> Self
pub fn finish_login( desk: &Desk, started: &StartedLogin, pasted: Option<&PastedToken>, output: &mut Output, ) -> Result<(), Failure>
pub fn help() -> Output
pub fn exec( desk: &mut Desk, invocation: Invocation, output: &mut Output, ) -> Result<Touched, Failure>
output::pub struct Output(String);
output::pub fn new() -> Self
output::pub fn as_str(&self) -> &str
output::pub fn is_empty(&self) -> bool
output::pub fn extend(&mut self, other: &Self)
