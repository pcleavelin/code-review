desk::pub struct PinTarget(String);
desk::pub fn new(text: &str) -> Self
desk::pub fn as_str(&self) -> &str
desk::pub struct PullAddress { pub repo: Option<RepoName>, pub number: PrNumber, }
desk::pub enum Pinned { Ready(Repo), Broken { root: Root, why: Why }, }
desk::pub struct Why(String);
desk::pub fn as_str(&self) -> &str
desk::pub struct Desk { store: Option<PinsStore>, here: Option<Repo>, pinned: Vec<Pinned>, }
desk::pub fn load(here: Option<&Root>, reach: Reach) -> Self
desk::pub fn of(store: Option<PinsStore>, here: Option<Repo>, roots: &[Root]) -> Self
desk::pub fn pinned(&self) -> &[Pinned]
desk::pub const fn here(&self) -> Option<&Repo>
desk::pub fn repos(&self) -> impl Iterator<Item = &Repo>
desk::pub fn names(&self) -> Vec<RepoName>
desk::pub fn pin(&mut self, target: &PinTarget) -> Result<RepoName, SessionError>
desk::pub fn unpin(&mut self, asked: &RepoName) -> Result<RepoName, SessionError>
desk::pub fn find(&self, address: &PullAddress) -> Result<&Repo, SessionError>
pub enum SessionError { Vcs(VcsError), NoRemote, Forge(ForgeError), Review(ReviewError), NotOpened(PrNumber, VcsError), Moved { number: PrNumber, reviewed: CommitId, now: CommitId, }, NothingToSubmit(PrNumber), NothingToDrop(PrNumber), SeenHeadGone { file: RelativePath, head: CommitId, }, NoPins, NoPinStore, Pins(io::Error), AlreadyPinned(RepoName), NoSuchRepo(RepoName, Vec<RepoName>), Ambiguous(PrNumber, Vec<RepoName>), }
repo::pub struct RepoName(String);
repo::pub fn new(text: &str) -> Self
repo::pub fn as_str(&self) -> &str
repo::pub fn answers_to(&self, asked: &Self) -> bool
repo::pub struct Opened { pub number: PrNumber, pub base: CommitId, pub head: CommitId, pub changes: Vec<FileChange>, pub commits: Vec<Commit>, pub review: Review, pub tree: PathBuf, }
repo::pub fn change(&self, path: &RelativePath) -> Option<&FileChange>
repo::pub fn seen(&self, change: &FileChange) -> Seen
repo::pub struct Entry { pub repo: RepoName, pub pull: PullRequest, pub progress: Option<Progress>, pub drafts: Vec<Draft>, pub standing: Standing, }
repo::pub struct Repo { root: Root, name: RepoName, vcs: Vcs, store: ReviewStore, remote: Remote, url: RemoteUrl, }
repo::pub fn find(root: &Root) -> Result<Self, SessionError>
repo::pub const fn root(&self) -> &Root
repo::pub const fn name(&self) -> &RepoName
repo::pub const fn remote(&self) -> &Remote
repo::pub fn web(&self) -> Option<Forge>
repo::pub fn forge(&self) -> Result<ForgeClient, SessionError>
repo::pub fn pulls(&self) -> Result<Vec<PullRequest>, SessionError>
repo::pub fn inbox(&self) -> Result<Vec<Entry>, SessionError>
repo::pub fn pull(&self, number: PrNumber) -> Result<PullRequest, SessionError>
repo::pub fn conversation(&self, pull: &PullRequest) -> Result<Conversation, SessionError>
repo::pub fn fetch(&self, pull: &PullRequest) -> Result<Opened, SessionError>
repo::pub fn state(&self, number: PrNumber) -> Result<Opened, SessionError>
repo::pub fn reopen(&self, number: PrNumber) -> Result<Opened, SessionError>
repo::pub fn drop_fetched(&self, number: PrNumber) -> Result<PathBuf, SessionError>
repo::pub fn since_seen( &self, opened: &Opened, change: &FileChange, mark: &Mark, ) -> Result<Option<FileChange>, SessionError>
repo::pub fn commit_changes(&self, commit: &CommitId) -> Result<Vec<FileChange>, SessionError>
repo::pub fn read_at( &self, commit: &CommitId, path: &RelativePath, ) -> Result<FileText, SessionError>
repo::pub fn review(&self, number: PrNumber) -> Result<Review, SessionError>
repo::pub fn save(&self, opened: &Opened) -> Result<(), SessionError>
repo::pub const fn store(&self) -> &ReviewStore
repo::pub fn submit( &self, opened: &mut Opened, decision: Decision, body: Option<&DraftText>, ) -> Result<Submitted, SessionError>
