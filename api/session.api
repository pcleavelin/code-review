pub enum SessionError { Vcs(VcsError), NoRemote, Forge(ForgeError), Review(ReviewError), NotOpened(PrNumber, VcsError), Moved { number: PrNumber, reviewed: CommitId, now: CommitId, }, SubmitRefused { number: PrNumber, refusal: Refusal, }, NothingToDrop(PrNumber), SeenHeadGone { file: RelativePath, head: CommitId, }, NoPins, NoPinStore, Pins(io::Error), AlreadyPinned(RepoName), NoSuchRepo(RepoName, Vec<RepoName>), Ambiguous(PrNumber, Vec<RepoName>), Keychain(KeychainError), NoKeychain, NoClient { host: Host, gap: MissingClient, file: Option<PathBuf>, }, Renewal { site: ForgeHost, cause: ForgeError, }, TokenRefused { site: ForgeHost, cause: ForgeError, }, NoSite(LoginTarget), }
