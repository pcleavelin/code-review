pub enum Reach { User, OverrideOnly, }
pub struct LayoutStore { path: PathBuf, }
pub const fn at(path: PathBuf) -> Self
pub fn find(reach: Reach) -> Option<Self>
pub fn path(&self) -> &Path
pub fn load(&self) -> Option<Layout>
pub fn save(&self, layout: &Layout) -> io::Result<()>
pub struct SettingsStore { path: PathBuf, }
pub const fn at(path: PathBuf) -> Self
pub fn find(reach: Reach) -> Option<Self>
pub fn path(&self) -> &Path
pub fn load(&self) -> Option<Settings>
pub fn save(&self, settings: &Settings) -> io::Result<()>
pub struct PinsStore { path: PathBuf, clones: Option<PathBuf>, }
pub const fn at(path: PathBuf, clones: Option<PathBuf>) -> Self
pub fn find(reach: Reach) -> Option<Self>
pub fn path(&self) -> &Path
pub fn clones(&self) -> Option<&Path>
pub fn load(&self) -> Vec<Root>
pub fn save(&self, pins: &[Root]) -> io::Result<()>
pub struct ForgesStore { path: PathBuf, }
pub const fn at(path: PathBuf) -> Self
pub fn find(reach: Reach) -> Option<Self>
pub fn path(&self) -> &Path
pub fn load(&self) -> Vec<OAuthApp>
pub fn jira_sites(&self) -> Vec<JiraSite>
pub fn add_jira(&self, site: &JiraSite) -> io::Result<()>
